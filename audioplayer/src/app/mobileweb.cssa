.encore-layout-themes,.encore-small-devices-theme {
    --encore-text-size-smaller-2: 0.6875rem;
    --encore-text-size-smaller: 0.8125rem;
    --encore-text-size-base: 1rem;
    --encore-text-size-large: 1.125rem;
